# Forward the scheduler's loopback API to this worker's localhost:8765.
RUNSPK_URL=http://127.0.0.1:8765
RUNSPK_WORKER_ID=worker-a
RUNSPK_CPU=2
RUNSPK_MEM_MIB=512
RUNSPK_ALLOW_NATIVE=true
RUST_LOG=info
# Alternative container-only worker: remove RUNSPK_ALLOW_NATIVE and set RUNSPK_RUNTIME=docker.
# Change the ID per host, and retain its data directory across restarts.
