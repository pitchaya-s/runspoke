[Unit]
Description=runspk SSH connection to scheduler
After=network.target

[Service]
Type=simple
# Replace scheduler-host with your SSH host; authenticate and verify its key interactively first.
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 127.0.0.1:8765:127.0.0.1:8765 scheduler-host
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
